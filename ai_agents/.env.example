# LLM providers (multi-provider strategy: local Llama 3 + Claude via API/OpenRouter)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3

# Groq (vision extraction for onboarding docs, and tool-calling for the
# Grand Orchestrator's routing LLM -- confirmed working on gpt-oss models,
# NOT the Llama-3-70B/8B originally specced, which this account can't reach)
GROQ_API_KEY=
# Vision/extraction chain (photo -> record): this Groq model first, then OpenRouter google/gemini-2.5-flash-lite (paid,
# ~$0.0002 a receipt) and a free model. llama-4-scout is not enabled on every Groq account (404); qwen3.8-27b is.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# DeepSeek (OpenRouter tier) reasons by default and can spend its whole output cap thinking; off unless set to low|medium|high.
# DEEPSEEK_REASONING=off
# Semantic input guard model (Groq) and kill switch; see orchestrator/security.py.
# GUARD_MODEL=openai/gpt-oss-safeguard-20b
# LLM_GUARD=off
ORCHESTRATOR_MODEL=openai/gpt-oss-20b
# Second provider: Claude via OpenRouter (OPENROUTER_API_KEY above; OPEN_ROUTER_API_KEY also accepted).
# Groq answers first; Claude takes over on any Groq error or quota limit (Groq's free tier caps tokens
# per day). Set ORCHESTRATOR_PROVIDER=openrouter to use Claude for the orchestrator only.
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_FREE_MODEL=nvidia/nemotron-3.5-lightning:free
# ORCHESTRATOR_PROVIDER=

# Hosted Llama API (Fleet Registry Agent router & validation sub-agent reasoning)
LLAMA_API_KEY=
LLAMA_API_BASE_URL=https://api.llama.com/compat/v1
LLAMA_API_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Backend REST API (Fleet Registry Agent's only path to Postgres for writes)
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and each call stalls ~2s.
BACKEND_API_BASE_URL=http://127.0.0.1:8000

# Agent memory (agent-memory.md + Pinecone_Migration_Hardened.md) -- facts are
# stored by the backend (Postgres = record, Pinecone = vectors) via
# /api/v1/memory. This module only computes 768-dim embeddings:
#   none     -> no vectors; recall is scope-filtered + keyword only (default)
#   pinecone -> Pinecone Inference llama-text-embed-v2, uses PINECONE_API_KEY
#   ollama   -> local Ollama, after `ollama pull nomic-embed-text`
#   nomic    -> Nomic's hosted API, needs NOMIC_API_KEY
MEMORY_EMBEDDER=none
OLLAMA_BASE_URL=http://localhost:11434
NOMIC_API_KEY=
# Background running-summary compression (defaults to ORCHESTRATOR_MODEL)
MEMORY_SUMMARIZER_MODEL=
# RAG triad LLM-as-a-judge (defaults to ORCHESTRATOR_MODEL)
RAG_JUDGE_MODEL=

# Pinecone -- here only for MEMORY_EMBEDDER=pinecone (embeddings). The vector
# index itself is owned by the backend (backend/.env).
PINECONE_API_KEY=

# Shared Postgres (read-only MCP access to historical fleet records)
DATABASE_URL=postgresql+psycopg://fleet:fleet@localhost:5432/fleet
