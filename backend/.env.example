# App
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://fleet:fleet@localhost:5432/fleet

# Security
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Agent-memory vector search (Pinecone). Leave the key empty to run memory
# Postgres-only (scope + keyword recall). Create the index once with:
#   python scripts/create_pinecone_index.py
PINECONE_API_KEY=
PINECONE_INDEX=fleet-memory
PINECONE_NAMESPACE=agent-memory
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Document RAG (hybrid-document-rag-pipeline.md). Uses the same Pinecone key
# (hosted dense/sparse embeddings + reranker) and its own dotproduct index.
PINECONE_DOCUMENTS_INDEX=fleet-documents
DOCUMENTS_NAMESPACE=rag_documents
# Calibrated for bge-reranker-v2-m3 -- see the spec before changing it.
RAG_RERANK_THRESHOLD=0.30
# Optional: table summarization during ingestion. Empty = tables indexed as Markdown.
GROQ_API_KEY=
RAG_SUMMARY_MODEL=openai/gpt-oss-20b
