# App
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://fleet:fleet@localhost:5432/fleet

# Security
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Agent-memory vector search (Pinecone). Leave the key empty to run memory
# Postgres-only (scope + keyword recall). Create the index once with:
#   python scripts/create_pinecone_index.py
PINECONE_API_KEY=
PINECONE_INDEX=fleet-memory
PINECONE_NAMESPACE=agent-memory
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
